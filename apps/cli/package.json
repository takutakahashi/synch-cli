{
  "name": "synch-cli",
  "private": true,
  "version": "0.1.0",
  "description": "Headless end-to-end encrypted sync CLI for Synch vaults.",
  "type": "module",
  "bin": {
    "synch": "./dist/synch.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest --config vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "chokidar": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@synch/sync-client": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.4"
  },
  "license": "MIT",
  "files": [
    "dist"
  ]
}
